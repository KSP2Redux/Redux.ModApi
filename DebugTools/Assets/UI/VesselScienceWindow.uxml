<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/VesselScienceWindow.uss?fileID=7433441132597879392&amp;guid=7ff452ae4fa10644b923b0f1a0043765&amp;type=3#VesselScienceWindow" />
    <ui:VisualElement name="root" class="dt-tool dt-science">
<ui:VisualElement class="kui-row"><ui:Label text="Vessel" class="kui-row__label" /><ui:DropdownField name="vessel" class="kui-field dt-science-picker" /></ui:VisualElement>
<ui:VisualElement class="kui-row"><ui:Label text="Use active vessel" class="kui-row__label" /><ui:Toggle name="use-active" value="true" class="switch" /></ui:VisualElement>
<ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="Situation" class="kui-section__title" /></ui:VisualElement>
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Research location" class="kui-stat__name" /><ui:Label name="research-location" text="Kerbin_Landed_KSC" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /></ui:VisualElement>
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Situation" class="kui-stat__name" /><ui:Label name="situation" text="Landed" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /></ui:VisualElement>
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Region" class="kui-stat__name" /><ui:Label name="region" text="KSC" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /></ui:VisualElement>
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Scalars (CB / Sit. / Reg.)" class="kui-stat__name" /><ui:Label name="scalars" text="1 / 1 / 1" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /></ui:VisualElement>
<ui:VisualElement class="kui-row"><ui:Label text="Region overlay strength" class="kui-row__label" /><ui:Slider name="overlay-strength" value="0" high-value="1" class="dt-science-slider" /></ui:VisualElement>
<ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="Experiment reports" class="kui-section__title" /></ui:VisualElement>
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Report storage" class="kui-stat__name" /><ui:Label name="has-storage-capacity" text="YES" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /></ui:VisualElement>
<ui:VisualElement class="kui-row dt-science-actions">
<UitkForKsp2.Controls.OabButton name="create-report" text="Create" class="kui-button" />
<UitkForKsp2.Controls.OabButton name="submit-report" text="Submit" class="kui-button" />
<UitkForKsp2.Controls.OabButton name="transmit-report" text="Transmit" class="kui-button" />
<UitkForKsp2.Controls.OabButton name="delete-reports" text="Delete" class="kui-button" />
</ui:VisualElement><ui:VisualElement class="dt-science-tables">
<ui:VisualElement class="dt-table dt-science-table"><ui:VisualElement class="dt-table__header"><ui:Label text="Experiment IDs" class="dt-table__cell" /></ui:VisualElement><ui:ScrollView name="experiment-ids" class="dt-science-list"><ui:Label text="Experiment ID 01" class="dt-table__row dt-table__cell" /><ui:Label text="Experiment ID 02" class="dt-table__row dt-table__cell" /><ui:Label text="Experiment ID 03" class="dt-table__row dt-table__cell" /></ui:ScrollView></ui:VisualElement>
<ui:VisualElement class="dt-table dt-science-table"><ui:VisualElement class="dt-table__header"><ui:Label text="Reports" class="dt-table__cell" /></ui:VisualElement><ui:ScrollView name="reports" class="dt-science-list"><ui:Label text="Report key 01" class="dt-table__row dt-table__cell" /><ui:Label text="Report key 02" class="dt-table__row dt-table__cell" /><ui:Label text="Report key 03" class="dt-table__row dt-table__cell" /></ui:ScrollView></ui:VisualElement>
</ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
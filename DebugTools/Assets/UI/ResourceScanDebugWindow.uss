.dt-scan-picker { flex-grow: 1; flex-basis: 0; min-width: 0; }
.dt-scan-columns { flex-direction: row; }
.dt-scan-column { flex-grow: 1; flex-basis: 0; min-width: 0; }
.dt-scan-list { max-height: 160px; min-height: 60px; background-color: rgba(34, 38, 46, 0.5); }
.dt-scan-list .unity-label { min-height: 20px; height: 20px; margin: 0; padding: 0 4px; font-size: 12px; -unity-text-align: middle-left; }

#scan-unscan { width: 140px; }
#scan-cb-all, #scan-all { width: 88px; margin-left: 4px; }
#unscan-cb-all, #unscan-all { width: 100px; margin-left: 4px; }

.dt-scan-picker-row > .kui-row__label { width: 132px; flex-grow: 0; flex-shrink: 0; }

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/ResourceScanDebugWindow.uss?fileID=7433441132597879392&amp;guid=d69ace9bc18b48144838ed3e95abdda0&amp;type=3#ResourceScanDebugWindow" />
    <ui:VisualElement name="root" class="dt-tool kui-dense">
        <ui:VisualElement class="kui-row dt-scan-picker-row"><ui:Label text="Celestial body" class="kui-row__label" /><ui:DropdownField name="celestial-body" class="kui-field dt-scan-picker" /></ui:VisualElement>
        <ui:VisualElement class="kui-row dt-scan-picker-row"><ui:Label text="Resource" class="kui-row__label" /><ui:DropdownField name="resource" class="kui-field dt-scan-picker" /></ui:VisualElement>
        <ui:VisualElement class="dt-scan-columns">
            <ui:VisualElement class="dt-scan-column">
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="UNSCANNED" class="kui-section__title" /></ui:VisualElement>
                <ui:ScrollView name="unscanned" class="dt-table dt-scan-list" horizontal-scroller-visibility="Hidden">
                    <ui:Label text="Ore" class="dt-table__row" />
                    <ui:Label text="Methane" class="dt-table__row" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement class="dt-scan-column">
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="SCANNED" class="kui-section__title" /></ui:VisualElement>
                <ui:ScrollView name="scanned" class="dt-table dt-scan-list" horizontal-scroller-visibility="Hidden">
                    <ui:Label text="Water" class="dt-table__row" />
                    <ui:Label text="Hydrogen" class="dt-table__row" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Selected resource" class="kui-row__label" /><UitkForKsp2.Controls.OabButton name="scan-unscan" text="Scan / unscan" class="kui-button " /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Selected body" class="kui-row__label" /><UitkForKsp2.Controls.OabButton name="scan-cb-all" text="Scan all" class="kui-button " /><UitkForKsp2.Controls.OabButton name="unscan-cb-all" text="Unscan all" class="kui-button " /></ui:VisualElement>
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-row"><ui:Label text="All bodies" class="kui-row__label" /><UitkForKsp2.Controls.OabButton name="scan-all" text="Scan all" class="kui-button " /><UitkForKsp2.Controls.OabButton name="unscan-all" text="Unscan all" class="kui-button " /></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

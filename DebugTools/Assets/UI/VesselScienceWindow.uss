.dt-science { min-width: 0; }
.dt-science .dt-science-value { flex-shrink: 1; min-width: 0; max-width: 65%; overflow: hidden; text-overflow: ellipsis; }
.dt-science-tables { flex-direction: row; flex-wrap: wrap; }
.dt-science-table { flex-grow: 1; flex-basis: 240px; min-width: 0; margin: 2px; }
.dt-science-list { height: 140px; }
.dt-science .dt-table__row { height: 20px; min-height: 20px; flex-shrink: 0; margin: 0; padding: 0 4px; -unity-text-align: middle-left; }
.dt-science .dt-table__cell { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dt-science .dt-table__header { height: 20px; }
.dt-science-picker { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-basis: 140px; margin-right: 4px; }
.dt-science-slider { width: 45%; min-width: 100px; height: 24px; margin: 0; }
.dt-science-actions > .kui-button { flex-grow: 1; flex-basis: 0; margin: 0 2px; }

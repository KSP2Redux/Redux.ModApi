.dt-quick-grid {
    min-width: 0;
}

.dt-quick-row {
    flex-direction: row;
    min-width: 0;
}

.dt-quick-button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px 4px 2px;
}

.dt-quick-button .oab-button__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
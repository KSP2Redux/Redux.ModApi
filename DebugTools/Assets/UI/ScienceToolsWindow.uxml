<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/ScienceToolsWindow.uss?fileID=7433441132597879392&amp;guid=2489ad47a778f5d4c9800e5353f5afe8&amp;type=3#ScienceToolsWindow" />
    <ui:VisualElement name="root" class="dt-tool dt-science">
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Agency" class="kui-stat__name" /><ui:Label name="agency-name" text="Kerbal Space Agency" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /></ui:VisualElement>
<ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Available science" class="kui-stat__name" /><ui:Label name="science-state" text="1234" display-tooltip-when-elided="true" class="kui-stat__value dt-science-value" /><ui:Label text="pts" class="kui-stat__unit" /></ui:VisualElement>
<ui:VisualElement class="kui-row"><ui:Label text="Science points" class="kui-row__label" /><ui:TextField name="add-points-field" value="100" class="kui-field dt-science-points" /><UitkForKsp2.Controls.OabButton name="add-points" text="Add" class="kui-button" /></ui:VisualElement>
<ui:VisualElement class="kui-row"><ui:Label text="Tech node" class="kui-row__label" /><ui:DropdownField name="available-nodes" class="kui-field dt-science-picker" /><UitkForKsp2.Controls.OabButton name="unlock-node" text="Unlock" class="kui-button" /></ui:VisualElement>
<ui:Foldout text="Tech nodes" value="false" class="kui-group"><ui:VisualElement class="dt-science-tables">
<ui:VisualElement class="dt-table dt-science-table"><ui:VisualElement class="dt-table__header"><ui:Label text="Loaded nodes" class="dt-table__cell" /></ui:VisualElement><ui:ScrollView name="loaded-nodes" class="dt-science-list"><ui:Label text="Node ID 01" class="dt-table__row dt-table__cell" /><ui:Label text="Node ID 02" class="dt-table__row dt-table__cell" /><ui:Label text="Node ID 03" class="dt-table__row dt-table__cell" /></ui:ScrollView></ui:VisualElement>
<ui:VisualElement class="dt-table dt-science-table"><ui:VisualElement class="dt-table__header"><ui:Label text="Unlocked nodes" class="dt-table__cell" /></ui:VisualElement><ui:ScrollView name="unlocked-nodes" class="dt-science-list"><ui:Label text="Node ID 01" class="dt-table__row dt-table__cell" /><ui:Label text="Node ID 02" class="dt-table__row dt-table__cell" /></ui:ScrollView></ui:VisualElement>
</ui:VisualElement></ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
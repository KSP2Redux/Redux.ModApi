/* Joints. Chrome-less tool, hosted as a pop-out window. The values are kui-stats, the switches are two columns of
   kui-rows and the joint list is a dt-table with one 20px line per joint. The rows are built in code, so the row,
   gauge and column names here are the ones JointsToolsWindowController creates. */

.jt-tool {
    width: 760px;
}

/* Stat grid: three columns of 24px stat rows */

.jt-stats {
    flex-direction: row;
    flex-wrap: wrap;
}

.jt-stat {
    width: 33%;
    padding: 0 8px;
    margin-bottom: 1px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.6);
}

.jt-stat--wide {
    width: 66%;
}

/* A stat that shares its row with a button takes the width the button leaves */
.jt-stat-inline {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 0 8px;
}

.jt-stat > .kui-stat__name,
.jt-stat-inline > .kui-stat__name {
    flex-shrink: 0;
}

.jt-stat > .kui-stat__value,
.jt-stat-inline > .kui-stat__value {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Controls inside the two switch grids */

.jt-dropdown {
    width: 170px;
    flex-shrink: 0;
}

.jt-number {
    width: 64px;
    flex-shrink: 0;
}

.jt-button {
    width: 64px;
    min-width: 64px;
    margin-left: 4px;
}

.jt-button-wide {
    width: 130px;
    min-width: 130px;
}

.jt-stress > .kui-row {
    width: 100%;
}

.jt-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.jt-stress-button {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 4px;
}

/* Joint table. Header and row cells share one set of widths: kind 96, name flexible, node 150, load 116, gauges 198. */

.jt-table {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.jt-table .dt-table__header > .unity-label {
    padding: 0 4px;
    margin: 0;
    color: rgb(214, 224, 255);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.jt-table .joint-kind {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 96px;
}

.jt-table .joint-name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.jt-table .joint-node {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 150px;
}

.jt-table .joint-magnitudes {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 116px;
}

.jt-table .joint-gauges {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    width: 198px;
}

.jt-gauge-head {
    width: 66px;
    padding: 0 4px;
    margin: 0;
    -unity-text-align: middle-left;
}

/* The themed scroll view paints its own inset panel, so it is reset to a flat list under the table header. */
.joint-rows {
    width: auto;
    height: 200px;
    min-height: 100px;
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0;
    border-radius: 0;
    background-color: rgb(23, 26, 32);
}

.joint-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 20px;
    min-height: 20px;
    border-left-width: 3px;
    border-left-color: rgba(120, 130, 150, 0.8);
}

.joint-row.hovered {
    background-color: rgba(123, 124, 240, 0.12);
    border-left-color: rgb(235, 239, 247);
}

.joint-row.selected {
    background-color: rgb(42, 45, 60);
    border-left-color: rgb(123, 124, 240);
}

.joint-row > .unity-label {
    margin: 0;
    padding: 0 4px;
    font-size: 12px;
    color: rgb(192, 199, 213);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.joint-row > .joint-kind {
    -unity-font-style: bold;
    color: rgb(214, 224, 255);
}

.joint-row > .joint-magnitudes {
    color: rgb(219, 181, 127);
}

/* Gauges: bar and percentage per row, F force, T torque, U utilization */

.joint-gauge {
    flex-direction: row;
    align-items: center;
    width: 62px;
    margin-right: 4px;
}

.joint-gauge-label {
    width: 10px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(214, 224, 255);
}

.joint-gauge-bar {
    flex-grow: 1;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.55);
}

.joint-gauge-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(61, 219, 97);
}

.joint-gauge-value {
    width: 28px;
    margin: 0 0 0 2px;
    padding: 0;
    font-size: 10px;
    -unity-text-align: middle-right;
    color: rgb(203, 211, 225);
}

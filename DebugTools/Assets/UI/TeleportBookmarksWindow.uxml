<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/TeleportBookmarksWindow.uss?fileID=7433441132597879392&amp;guid=188e3551c3d777149acf76ec2d75fc01&amp;type=3#TeleportBookmarksWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <ui:VisualElement name="root" class="dt-tool">
        <ui:VisualElement class="kui-row">
            <UitkForKsp2.Controls.OabButton text="Teleport to KSC" display-tooltip-when-elided="true" name="teleport-to-ksc" class="kui-button tb-ksc" />
            <ui:Label text="Auto-save on teleport" class="kui-row__label tb-autosave-label" />
            <ui:Toggle name="autosave-on-teleport" class="switch" />
        </ui:VisualElement>
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="Bookmarks" class="kui-section__title" /></ui:VisualElement>
        <ui:VisualElement class="kui-row">
            <ui:Label text="List" class="kui-row__label tb-list-label" />
            <ui:DropdownField index="0" choices="Default,Orbits" name="selected-list" class="kui-field tb-picker" />
            <UitkForKsp2.Controls.OabButton text="Previous" tooltip="Teleport to the previous bookmark in the list" display-tooltip-when-elided="true" name="previous-bookmark" class="kui-button tb-step" />
            <UitkForKsp2.Controls.OabButton text="Next" tooltip="Teleport to the next bookmark in the list" display-tooltip-when-elided="true" name="next-bookmark" class="kui-button tb-step" />
        </ui:VisualElement>
        <ui:VisualElement class="dt-table tb-table">
            <ui:VisualElement class="dt-table__header teleport-bookmark-row teleport-bookmark-row__header">
                <ui:Label text="Name" class="teleport-bookmark-row__name" />
                <ui:Label text="Body" class="teleport-bookmark-row__body-name" />
                <ui:Label text="Type" class="teleport-bookmark-row__type" />
                <ui:VisualElement class="teleport-bookmark-row__actions" />
            </ui:VisualElement>
            <ui:ScrollView name="bookmarks" class="tb-scroll">
                <DebugTools.Runtime.UI.TeleportBookmarkRow />
                <DebugTools.Runtime.UI.TeleportBookmarkRow class="teleport-bookmark-row__selected" />
                <DebugTools.Runtime.UI.TeleportBookmarkRow />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="kui-row tb-add-row">
            <UitkForKsp2.Controls.PlaceholderTextField name="save-bookmark-field" placeholder="New bookmark name" tooltip="Leave empty to name the bookmark after the current universal time" class="oab-text-field kui-field tb-field" />
            <UitkForKsp2.Controls.OabButton text="Add" tooltip="Save the active vessel's position as a bookmark" display-tooltip-when-elided="true" name="save-bookmark" class="kui-button" />
        </ui:VisualElement>
        <ui:Foldout text="Manage lists" value="false" class="kui-group">
            <ui:VisualElement class="kui-row">
                <UitkForKsp2.Controls.PlaceholderTextField name="bookmarks-list-name" placeholder="New list name" class="oab-text-field kui-field tb-field" />
                <UitkForKsp2.Controls.OabButton text="Create" display-tooltip-when-elided="true" name="create-bookmarks-list" class="kui-button" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row">
                <ui:Label text="Selected list" class="kui-row__label" />
                <UitkForKsp2.Controls.OabButton text="Delete" tooltip="Delete the selected list. At least one list must remain" display-tooltip-when-elided="true" name="delete-list" class="kui-button tb-manage-button" />
                <UitkForKsp2.Controls.OabButton text="Save all" tooltip="Write every list to disk" display-tooltip-when-elided="true" name="save-lists" class="kui-button tb-manage-button" />
            </ui:VisualElement>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>

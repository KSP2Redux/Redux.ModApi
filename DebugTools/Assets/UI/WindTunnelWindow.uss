.wind-tunnel { width: 800px; min-width: 760px; max-width: 800px; max-height: 640px; flex-shrink: 1; min-height: 0; }
.wind-tunnel > Label, .wind-tunnel > .kui-field, .wind-tunnel > .kui-button, .wind-tunnel > TemplateContainer { flex-shrink: 0; }
.wind-tunnel .kui-value { white-space: normal; }
.wind-tunnel-header { flex-shrink: 0; padding-right: 13px; background-color: rgb(46, 53, 64); }
.wind-tunnel-results { max-height: 180px; min-height: 0; flex-shrink: 1; padding: 0; }
.wind-tunnel-cell { flex-grow: 1; flex-basis: 0; min-width: 0; -unity-text-align: middle-right; font-size: 11px; }
.wind-tunnel-row { flex-direction: row; min-height: 22px; flex-shrink: 0; }
.wind-arrow-buttons { flex-direction: row; flex-shrink: 0; }
.wind-arrow-buttons .kui-button { flex-grow: 1; flex-basis: 0; min-width: 0; }
.wind-tunnel > .unity-scroll-view__content-viewport { min-width: 0; }
.wind-tunnel .unity-scroll-view__content-container { min-width: 0; }

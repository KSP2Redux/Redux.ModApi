<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="DebugWindow.uss" />
    <Style src="StaticFireStandWindow.uss" />
    <ui:ScrollView name="root" class="dt-tool kui-dense static-fire">
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="SUBJECT" class="kui-section__title" /></ui:VisualElement>
        <ui:Label name="subject" class="kui-value static-fire-wrap" />
        <ui:DropdownField name="engine" label="Engines" class="kui-field" />
        <UitkForKsp2.Controls.OabButton name="refresh" text="Refresh active vessel" class="kui-button" />
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="CONDITIONS" class="kui-section__title" /></ui:VisualElement>
        <ui:VisualElement class="kui-row">
            <UitkForKsp2.Controls.OabButton name="vacuum" text="Vacuum" class="kui-button" />
            <UitkForKsp2.Controls.OabButton name="kerbin" text="Kerbin SL (1 atm)" class="kui-button" />
            <UitkForKsp2.Controls.OabButton name="eve" text="Eve SL (4 atm)" class="kui-button" />
        </ui:VisualElement>
        <ui:Slider name="pressure" low-value="-4" high-value="0.69897" value="0" />
        <ui:VisualElement class="static-fire-ticks">
            <ui:Label text="| 0 atm" class="kui-value static-fire-tick-zero" />
            <ui:Label text="| 1" class="kui-value static-fire-tick-one" />
            <ui:Label text="| 4" class="kui-value static-fire-tick-four" />
        </ui:VisualElement>
        <ui:Label name="pressure-value" class="kui-value static-fire-wrap" />
        <ui:DropdownField name="quality" label="Plume quality" class="kui-field" />
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="RUN" class="kui-section__title" /></ui:VisualElement>
        <ui:Label text="Start holds the vessel. Stage or ignite engines normally. Stop restores the original throttle, which may be nonzero." class="kui-value static-fire-wrap" />
        <ui:Slider name="throttle" label="Throttle (%)" low-value="0" high-value="100" value="0" show-input-field="true" />
        <ui:FloatField name="duration" label="Sweep duration (s)" value="10" class="kui-field" />
        <ui:VisualElement class="kui-row">
            <UitkForKsp2.Controls.OabButton name="start" text="Start hold" class="kui-button" />
            <UitkForKsp2.Controls.OabButton name="sweep" text="Sweep 0 to 100%" class="kui-button" />
            <UitkForKsp2.Controls.OabButton name="stop" text="Stop and restore" class="kui-button" />
        </ui:VisualElement>
        <ui:Label name="status" class="kui-value static-fire-wrap" />
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="RESULTS" class="kui-section__title" /></ui:VisualElement>
        <ui:Label name="results" text="Start a run to read live engine telemetry." class="kui-value static-fire-wrap" />
        <UitkForKsp2.Controls.OabButton name="capture" text="Capture bench report" class="kui-button" />
    </ui:ScrollView>
</ui:UXML>

.ThermalDataWindow .vessel-table { height: 260px; min-height: 100px; }
.ThermalDataWindow .data-row { flex-direction: row; height: 20px; min-height: 20px; flex-shrink: 0; width: 1480px; font-size: 12px; }
.ThermalDataWindow .data-row > Label { font-size: 12px; flex-grow: 1; flex-basis: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-right; margin: 0; padding: 0 5px; }
.ThermalDataWindow .data-row > .data-row-entry-large { flex-grow: 2; -unity-text-align: middle-left; }
.dt-palette {
    width: 700px;
    max-height: 760px;
}
.dt-palette-body {
    padding: 8px;
    flex-shrink: 1;
    min-height: 0;
}
.dt-palette-help {
    font-size: 12px;
    margin-top: 4px;
    margin-bottom: 4px;
}
.dt-palette-results {
    height: 320px;
    flex-shrink: 1;
    min-height: 80px;
}
.dt-palette-result {
    white-space: normal;
    -unity-text-align: middle-left;
    height: auto;
    min-height: 30px;
    flex-shrink: 0;
    margin-bottom: 2px;
}
.dt-palette-unavailable {
    opacity: 0.45;
}
.dt-palette-details-scroll {
    max-height: 220px;
    flex-shrink: 1;
    margin-top: 6px;
    margin-bottom: 6px;
}
.dt-palette-details {
    white-space: normal;
    height: auto;
    flex-shrink: 0;
    -unity-text-align: upper-left;
    font-size: 12px;
}

.dt-palette-help { white-space: normal; height: auto; flex-shrink: 0; }
.dt-palette .unity-scroll-view__content-container { min-width: 0; }

.dt-palette-details-scroll { height: auto; min-height: 0; }

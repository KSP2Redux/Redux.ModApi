<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="DebugWindow.uss" />
    <Style src="ModuleBenchWindow.uss" />
    <ui:ScrollView name="root" class="dt-tool kui-dense module-bench">
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="SUBJECT" class="kui-section__title" /></ui:VisualElement>
        <ui:DropdownField name="module" label="Module type" class="kui-field" />
        <ui:Label name="subject" class="kui-value module-bench-wrap" />
        <UitkForKsp2.Controls.OabButton name="refresh" text="Refresh active vessel" class="kui-button" />
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="CONDITIONS" class="kui-section__title" /></ui:VisualElement>
        <ui:DropdownField name="preset" label="Preset" class="kui-field" />
        <ui:FloatField name="power" label="Thermal test load (kW)" value="100" class="kui-field" />
        <ui:Label text="Sunlight / Shade: observe natural light and deployment, without forcing illumination. Radiator: enable cooling with heat and power available. Thermal load: existing heater on the first vessel part. Heat shield: use reentry-capsule-2part with Reentry. Antenna: computed range and live link state only, without moving vessels. Converter: enable a recipe with inputs and output storage available." class="kui-value module-bench-wrap" />
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="RUN" class="kui-section__title" /></ui:VisualElement>
        <ui:FloatField name="duration" label="Duration (s)" value="10" class="kui-field" />
        <ui:VisualElement class="kui-row">
            <UitkForKsp2.Controls.OabButton name="start" text="Run observation" class="kui-button" />
            <UitkForKsp2.Controls.OabButton name="stop" text="Stop and restore" class="kui-button" />
        </ui:VisualElement>
        <ui:Label name="status" class="kui-value module-bench-wrap" />
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="RESULTS" class="kui-section__title" /></ui:VisualElement>
        <ui:Label text="5% comparison threshold allows tick-boundary solver latency over 10 s. Differences require review of conditions. Net resource rates include other modules. Requested rates and cooler offered power do not prove delivery." class="kui-value module-bench-wrap" />
        <ui:Label name="results" text="Run a bench to measure modules." class="kui-value module-bench-wrap" />
        <UitkForKsp2.Controls.OabButton name="capture" text="Capture bench report" class="kui-button" />
    </ui:ScrollView>
</ui:UXML>

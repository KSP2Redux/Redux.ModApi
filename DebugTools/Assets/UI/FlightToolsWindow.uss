/* Sim Objects (Flight Tools). Chrome-less tool: the hub or the pop-out shell supplies the frame. Switches are kui-rows,
   the two lists are dt-tables. The item rows are built in code (SimObjectItem, JointConnectionItem), so they are styled
   here by their own class names. Column widths of the headers and of the rows must match. */

.ft-tool {
    width: 660px;
}

.ft-dropdown {
    width: 170px;
    flex-shrink: 0;
}

/* The themed scroll view paints its own inset panel, so it is reset to a flat list under the table header. */
.ft-table {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
}

.ft-items {
    width: auto;
    height: 220px;
    min-height: 60px;
    flex-shrink: 1;
    padding: 0;
    border-radius: 0;
    background-color: rgb(23, 26, 32);
}

.ft-table > .dt-table__header > .unity-label {
    padding: 0 4px;
    margin: 0;
    color: rgb(214, 224, 255);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* Sim object row: name, physics, parent frame, then three buttons of the same width */

.ft-head-name,
.ft-table .sim-object-item > .sim-object-item_name {
    flex-grow: 3;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    max-width: none;
}

.ft-head-physics,
.ft-table .sim-object-item > .sim-object-item_physics-mode {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 84px;
    max-width: none;
}

.ft-head-frame,
.ft-table .sim-object-item > .sim-object-item_parent-frame {
    flex-grow: 5;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    max-width: none;
}

.ft-head-actions {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 228px;
}

.ft-table .sim-object-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    height: 20px;
    min-height: 20px;
    margin: 0;
    font-size: 12px;
}

.ft-table .sim-object-item:hover,
.ft-table .joint-connection-item:hover {
    background-color: rgba(123, 124, 240, 0.08);
}

.ft-table .sim-object-item > .unity-label,
.ft-table .joint-connection-item > .unity-label {
    margin: 0;
    padding: 0 4px;
    font-size: 12px;
    color: rgb(192, 199, 213);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ft-table .sim-object-item > .unity-button,
.ft-table .joint-connection-item > .unity-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 72px;
    min-width: 0;
    height: 18px;
    min-height: 0;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 11px;
}

/* The kui-button plate of a plain Button is 24px high, so the row version is set to 18px here. */
.ft-table .sim-object-item > .kui-button.unity-button.unity-text-element,
.ft-table .joint-connection-item > .kui-button.unity-button.unity-text-element {
    width: 72px;
    min-width: 0;
    height: 18px;
    min-height: 0;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 11px;
}

/* Joint connection row: count, host, target, node type, joint type, destroy */

.ft-head-small,
.ft-table .joint-connection-item > .unity-label {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 72px;
}

.ft-table .joint-connection-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    height: 20px;
    min-height: 20px;
    margin: 0;
    font-size: 12px;
}

.ft-head-joint-name,
.ft-table .joint-connection-item > .joint-connection-item_name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    max-width: none;
}

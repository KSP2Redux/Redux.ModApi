.part-gizmos { width: 600px; min-width: 420px; max-width: 600px; flex-grow: 0; max-height: 680px; }
.part-gizmos.unity-scroll-view { height: auto; }
.part-gizmos .unity-scroll-view__content-container { min-width: 0; flex-grow: 0; }
.part-gizmos .gizmos-wrap { white-space: normal; height: auto; flex-shrink: 0; -unity-text-align: upper-left; }
.part-gizmos .kui-field, .part-gizmos .dt-actions { flex-shrink: 0; }
.part-gizmos .dt-actions > .kui-button { flex-grow: 1; flex-basis: 0; min-width: 0; height: auto; white-space: normal; }

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/TerrainDebugWindow.uss?fileID=7433441132597879392&amp;guid=e2cb55e06000f684180b794e3d61eddf&amp;type=3#TerrainDebugWindow" />
    <ui:VisualElement name="root" class="dt-tool kui-dense">
        <ui:VisualElement class="dt-grid-2 dt-terrain-switches">
        <ui:VisualElement class="kui-row"><ui:Label text="Biome colors" class="kui-row__label" /><ui:Toggle name="show-biome-colors" class="switch" /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Triplanar boost" class="kui-row__label" /><ui:Toggle name="boost-triplanar-contrast" class="switch" /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Wireframe" class="kui-row__label" /><ui:Toggle name="render-wireframe" class="switch" /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="PhysX bubble" class="kui-row__label" /><ui:Toggle name="render-physx-bubble" class="switch" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="kui-row dt-terrain-picker-row"><ui:Label text="Show biomes" class="kui-row__label" /><ui:DropdownField name="show-biomes" class="kui-field dt-terrain-picker" /></ui:VisualElement>
        <ui:VisualElement class="kui-row dt-terrain-picker-row"><ui:Label text="Show triplanar" class="kui-row__label" /><ui:DropdownField name="show-triplanar" class="kui-field dt-terrain-picker" /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Triplanar basis" class="kui-row__label" /><UitkForKsp2.Controls.OabButton name="update-triplanar-basis" text="Update" class="kui-button " /><UitkForKsp2.Controls.OabButton name="reset-triplanar-basis" text="Reset" class="kui-button " /></ui:VisualElement>
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="PQS" class="kui-section__title" /></ui:VisualElement>
        <ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Since basis update" class="kui-stat__name" /><ui:Label name="time-since-tp-update" text="10" class="kui-stat__value" /><ui:Label text="s" class="kui-stat__unit" /></ui:VisualElement>
        <ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Visible quads" class="kui-stat__name" /><ui:Label name="pqs-stats" text="51132" class="kui-stat__value" /><ui:Label text="" class="kui-stat__unit" /></ui:VisualElement>
        <ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Mesh slots" class="kui-stat__name" /><ui:Label name="pqs-slots" text="512 / 1024" class="kui-stat__value" /><ui:Label text="" class="kui-stat__unit" /></ui:VisualElement>
        <ui:VisualElement class="kui-stat"><ui:VisualElement class="kui-stat__icon" /><ui:Label text="Active colliders" class="kui-stat__name" /><ui:Label name="pqs-colliders" text="12312" class="kui-stat__value" /><ui:Label text="" class="kui-stat__unit" /></ui:VisualElement>
        <ui:VisualElement class="kui-divider" />
        <ui:VisualElement class="kui-row"><ui:Label name="debug-quad-status" text="Quad: 42" class="kui-row__label" /><UitkForKsp2.Controls.OabButton name="select-quad" text="Select quad" class="kui-button " /></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

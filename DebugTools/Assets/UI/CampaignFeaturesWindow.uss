.campaign-features { width: 640px; min-width: 420px; max-width: 640px; max-height: 620px; }
.campaign-features .unity-scroll-view__content-container { flex-shrink: 1; min-width: 0; flex-grow: 0; }
.campaign-features .qa-preview-wrap { white-space: normal; flex-shrink: 0; margin-bottom: 6px; height: auto; }
.campaign-features .kui-button { flex-grow: 1; flex-shrink: 0; flex-basis: auto; min-width: 0; }
.campaign-features .feature-row { margin-top: 6px; flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: center; }
.campaign-features .feature-row > .kui-field { flex-grow: 1; flex-basis: 250px; min-width: 0; }
.campaign-features .feature-row > .qa-preview-wrap { flex-grow: 1; flex-basis: 280px; min-width: 0; }
.campaign-features .unity-toggle__label { min-width: 0; white-space: normal; height: auto; flex-shrink: 0; }
.campaign-features .unity-scroll-view { height: auto; }
.campaign-features.unity-scroll-view { height: auto; }

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/KerbalRosterToolWindow.uss?fileID=7433441132597879392&amp;guid=950d6e837f92a714fbccbf76c2612da2&amp;type=3#KerbalRosterToolWindow" />
    <ui:VisualElement name="root" class="dt-tool kui-dense">
        <ui:VisualElement class="kui-row"><ui:Label text="Roster" class="kui-row__label" /><UitkForKsp2.Controls.OabButton name="add-random-kerbal" text="Add random" class="kui-button " /><UitkForKsp2.Controls.OabButton name="reset-kerbal-roster" text="Reset roster" class="kui-button " /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Add by name" class="kui-row__label" /><ui:TextField name="add-by-name-field" class="kui-field dt-roster-input" /><UitkForKsp2.Controls.OabButton name="add-by-name" text="Add" class="kui-button " /></ui:VisualElement>
        <ui:VisualElement class="kui-row"><ui:Label text="Add count" class="kui-row__label" /><ui:TextField name="add-x-field" class="kui-field dt-roster-input" /><UitkForKsp2.Controls.OabButton name="add-x" text="Add" class="kui-button " /></ui:VisualElement>
        <ui:VisualElement class="kui-section"><ui:Label text="//" class="kui-section__slashes" /><ui:Label text="CREW" class="kui-section__title" /></ui:VisualElement>
        <ui:ScrollView name="roster" class="dt-table dt-roster-table" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement class="dt-table__header"><ui:Label text="Name" class="dt-table__cell dt-roster-name" /><ui:Label text="Sim object" class="dt-table__cell dt-roster-object" /><ui:Label text="Seat" class="dt-table__cell dt-roster-seat" /><ui:Label text="Enrolled" class="dt-table__cell dt-roster-date" /><ui:Label text="" class="dt-table__cell dt-roster-action" /></ui:VisualElement>
            <ui:VisualElement class="dt-table__row"><ui:Label text="Valentina Kerman" class="dt-table__cell dt-roster-name" /><ui:Label text="c37a9f02" class="dt-table__cell dt-roster-object" /><ui:Label text="0" class="dt-table__cell dt-roster-seat" /><ui:Label text="123456789" class="dt-table__cell dt-roster-date" /><ui:Button text="Del" class="kui-button dt-roster-action" /></ui:VisualElement>
            <ui:VisualElement class="dt-table__row"><ui:Label text="Bob Kerman" class="dt-table__cell dt-roster-name" /><ui:Label text="9d41be72" class="dt-table__cell dt-roster-object" /><ui:Label text="1" class="dt-table__cell dt-roster-seat" /><ui:Label text="123456790" class="dt-table__cell dt-roster-date" /><ui:Button text="Del" class="kui-button dt-roster-action" /></ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>

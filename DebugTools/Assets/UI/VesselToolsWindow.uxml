<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow"/>
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/VesselToolsWindow.uss?fileID=7433441132597879392&amp;guid=6432abe36f3f99a4487427c943339ec3&amp;type=3#VesselToolsWindow"/>
    <ui:VisualElement name="root" class="dt-tool VesselToolsWindow">
        <ui:VisualElement class="dt-tool-body">
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Markers" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:VisualElement class="dt-grid-2">
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Control points" class="kui-row__label"/>
                    <ui:Toggle name="show-control-points" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Navball rotation" class="kui-row__label"/>
                    <ui:Toggle name="cp-follow-navball" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="SAS targets" class="kui-row__label"/>
                    <ui:Toggle name="show-sas" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Orbit points" class="kui-row__label"/>
                    <ui:Toggle name="show-orbit-points" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Joint markers" class="kui-row__label"/>
                    <ui:Toggle name="show-joints" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Part bounds" class="kui-row__label"/>
                    <ui:Toggle name="parts-bounds" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Buoyancy" class="kui-row__label"/>
                    <ui:Toggle name="show-cob" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Center of mass" class="kui-row__label"/>
                    <ui:Toggle name="show-com-markers" class="switch"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-row marker-row">
                    <ui:Label text="Physics forces" class="kui-row__label"/>
                    <ui:Toggle name="show-physics-force" class="switch"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="kui-row">
                <ui:Label text="Marker size" class="kui-row__label"/>
                <ui:Slider name="com-markers-size" value="1" low-value="0" high-value="5" class="marker-slider"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
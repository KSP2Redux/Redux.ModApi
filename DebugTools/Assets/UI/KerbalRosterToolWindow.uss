.dt-roster-input { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 8px; }
.dt-roster-table { max-height: 200px; min-height: 60px; flex-shrink: 1; }
.dt-roster-table .dt-table__row, .dt-roster-table .dt-table__header { min-height: 20px; flex-shrink: 0; align-items: center; }
.dt-roster-table .dt-table__cell { margin: 0; padding: 0 3px; white-space: nowrap; text-overflow: ellipsis; }
.dt-roster-table .dt-roster-name { flex-grow: 3; }
.dt-roster-table .dt-roster-object { flex-grow: 2; }
.dt-roster-table .dt-roster-seat { flex-grow: 0; flex-basis: 48px; }
.dt-roster-table .dt-roster-date { flex-grow: 0; flex-basis: 82px; }
.dt-roster-table .dt-roster-action { flex-grow: 0; flex-basis: 38px; }
.kui-dense .dt-roster-table .dt-roster-action.unity-button { height: 18px; min-height: 18px; min-width: 0; padding: 0 3px; margin: 0; font-size: 12px; }

#add-random-kerbal, #reset-kerbal-roster { width: 116px; margin-left: 4px; }
.dt-tool > .kui-row > .kui-row__label { flex-basis: 0; min-width: 0; }

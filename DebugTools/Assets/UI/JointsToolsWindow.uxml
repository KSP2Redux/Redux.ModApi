<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow" />
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/JointsToolsWindow.uss?fileID=7433441132597879392&amp;guid=358950aa23d1e384f81e759931ff407f&amp;type=3#JointsToolsWindow" />
    <ui:VisualElement name="root" class="dt-tool jt-tool">
        <ui:VisualElement class="kui-section">
            <ui:Label text="//" class="kui-section__slashes" />
            <ui:Label text="Active vessel" class="kui-section__title" />
        </ui:VisualElement>
        <ui:VisualElement name="summary" class="jt-stats">
            <ui:VisualElement class="kui-stat jt-stat jt-stat--wide">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Vessel" class="kui-stat__name" />
                <ui:Label name="vessel-name" text="No active vessel" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Physics" class="kui-stat__name" />
                <ui:Label name="stat-physics" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Situation" class="kui-stat__name" />
                <ui:Label name="stat-situation" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Parts" class="kui-stat__name" />
                <ui:Label name="stat-parts" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Mode" class="kui-stat__name" />
                <ui:Label name="stat-mode" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Analytical" class="kui-stat__name" />
                <ui:Label name="stat-analytical" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Legacy" class="kui-stat__name" />
                <ui:Label name="stat-legacy" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="PhysX CJ" class="kui-stat__name" />
                <ui:Label name="stat-physx" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="RB owner/parts" class="kui-stat__name" />
                <ui:Label name="stat-rigidbodies" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Max stress" class="kui-stat__name" />
                <ui:Label name="stat-max" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Solved" class="kui-stat__name" />
                <ui:Label name="stat-solved" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Override" class="kui-stat__name" />
                <ui:Label name="stat-override" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-stat jt-stat">
                <ui:VisualElement class="kui-stat__icon" />
                <ui:Label text="Graph" class="kui-stat__name" />
                <ui:Label name="stat-graph" text="n/a" class="kui-stat__value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="kui-section">
            <ui:Label text="//" class="kui-section__slashes" />
            <ui:Label text="Show" class="kui-section__title" />
        </ui:VisualElement>
        <ui:VisualElement name="filters" class="dt-grid-2">
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Active Vessel Only" class="kui-row__label dt-row__text" />
                <ui:Toggle name="active-vessel-only" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Analytical" class="kui-row__label dt-row__text" />
                <ui:Toggle name="show-analytical" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Legacy PhysX/Virtual" class="kui-row__label dt-row__text" />
                <ui:Toggle name="show-legacy" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Markers" class="kui-row__label dt-row__text" />
                <ui:Toggle name="show-markers" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Stress Gauges" class="kui-row__label dt-row__text" />
                <ui:Toggle name="show-stress-gauges" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Sort" class="kui-row__label dt-row__text" />
                <ui:DropdownField name="sort-mode" index="0" choices="MaxUtilization,TreeOrder" class="kui-field jt-dropdown" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label name="stat-selected" text="Selected: none" class="kui-row__label dt-row__text" />
                <UitkForKsp2.Controls.OabButton text="Clear Selection" name="clear-selection" class="kui-button jt-button-wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="kui-section">
            <ui:Label text="//" class="kui-section__slashes" />
            <ui:Label text="Joint physics" class="kui-section__title" />
        </ui:VisualElement>
        <ui:VisualElement name="settings" class="dt-grid-2">
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Multi Joints" class="kui-row__label dt-row__text" />
                <ui:Toggle name="multi-joints" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Inertia Tensor Fix" class="kui-row__label dt-row__text" />
                <ui:Toggle name="inertia-tensor-fix" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Dynamic Tensor Solution" class="kui-row__label dt-row__text" />
                <ui:Toggle name="dynamic-tensor-solution" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Scaled Solver Iteration" class="kui-row__label dt-row__text" />
                <ui:Toggle name="scaled-solver-iteration" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Joints Enabled" class="kui-row__label dt-row__text" />
                <ui:Toggle name="joints-enabled" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Extra Joints" class="kui-row__label dt-row__text" />
                <ui:Toggle name="extra-joints" class="switch" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Extra Mode" class="kui-row__label dt-row__text" />
                <ui:DropdownField name="extra-joints-mode" index="0" choices="Default" class="kui-field jt-dropdown" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label name="mode-value" text="RigidBody Mode: n/a" class="kui-row__label dt-row__text" />
                <UitkForKsp2.Controls.OabButton text="Pack" name="set-packed" class="kui-button jt-button" />
                <UitkForKsp2.Controls.OabButton text="Unpack" name="set-unpacked" class="kui-button jt-button" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label name="rigidity-value" text="Rigidity: 0.0" class="kui-row__label dt-row__text" />
                <ui:TextField name="joint-rigidity-input" value="0.0" class="kui-field jt-number" />
                <UitkForKsp2.Controls.OabButton text="Set" name="set-joint-rigidity" class="kui-button jt-button" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label name="stack-rigidity-value" text="Stack: 0.0" class="kui-row__label dt-row__text" />
                <ui:TextField name="stack-rigidity-input" value="0.0" class="kui-field jt-number" />
                <UitkForKsp2.Controls.OabButton text="Set" name="set-stack-rigidity" class="kui-button jt-button" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label name="surface-rigidity-value" text="Surface: 0.0" class="kui-row__label dt-row__text" />
                <ui:TextField name="surface-rigidity-input" value="0.0" class="kui-field jt-number" />
                <UitkForKsp2.Controls.OabButton text="Set" name="set-surface-rigidity" class="kui-button jt-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="kui-section">
            <ui:Label text="//" class="kui-section__slashes" />
            <ui:Label text="Stress override" class="kui-section__title" />
        </ui:VisualElement>
        <ui:VisualElement name="stress-override" tooltip="Presentation only. It cannot break joints or change physics." class="jt-stress">
            <ui:VisualElement class="kui-row dt-row">
                <ui:Label text="Presentation Stress" class="kui-row__label dt-row__text" />
                <ui:Slider name="stress-override-value" low-value="0" high-value="1" value="0.85" show-input-field="true" class="jt-slider" />
            </ui:VisualElement>
            <ui:VisualElement class="kui-row dt-row">
                <UitkForKsp2.Controls.OabButton text="Set Selected" name="set-selected-stress" class="kui-button jt-stress-button" />
                <UitkForKsp2.Controls.OabButton text="Set All" name="set-all-stress" class="kui-button jt-stress-button" />
                <UitkForKsp2.Controls.OabButton text="Clear Selected" name="clear-selected-stress" class="kui-button jt-stress-button" />
                <UitkForKsp2.Controls.OabButton text="Clear All" name="clear-all-stress" class="kui-button jt-stress-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="kui-section">
            <ui:Label text="//" class="kui-section__slashes" />
            <ui:Label text="Joints" class="kui-section__title" />
        </ui:VisualElement>
        <ui:VisualElement class="dt-table jt-table">
            <ui:VisualElement name="joint-header" class="dt-table__header">
                <ui:Label text="Type" class="dt-table__cell joint-kind" />
                <ui:Label text="Connection" class="dt-table__cell joint-name" />
                <ui:Label text="Node" class="dt-table__cell joint-node" />
                <ui:Label text="Load" class="dt-table__cell joint-magnitudes" />
                <ui:VisualElement name="header-gauges" class="joint-gauges">
                    <ui:Label text="F" class="jt-gauge-head" />
                    <ui:Label text="T" class="jt-gauge-head" />
                    <ui:Label text="Max" class="jt-gauge-head" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="joint-rows" scroll-deceleration-rate="0.135" elasticity="0.1" class="joint-rows">
                <ui:VisualElement class="joint-row dt-table__row">
                    <ui:Label text="A" class="dt-table__cell joint-kind" />
                    <ui:Label text="Part A -> Part B" class="dt-table__cell joint-name" />
                    <ui:Label text="Stack  #1" class="dt-table__cell joint-node" />
                    <ui:Label text="F:120N T:35Nm" class="dt-table__cell joint-magnitudes" />
                    <ui:VisualElement class="joint-gauges">
                        <ui:VisualElement class="joint-gauge"><ui:Label text="F" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" style="width: 20%;" /></ui:VisualElement><ui:Label text="20%" class="joint-gauge-value" /></ui:VisualElement>
                        <ui:VisualElement class="joint-gauge"><ui:Label text="T" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" style="width: 10%;" /></ui:VisualElement><ui:Label text="10%" class="joint-gauge-value" /></ui:VisualElement>
                        <ui:VisualElement class="joint-gauge"><ui:Label text="U" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" style="width: 20%;" /></ui:VisualElement><ui:Label text="20%" class="joint-gauge-value" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="joint-row dt-table__row selected">
                    <ui:Label text="A" class="dt-table__cell joint-kind" />
                    <ui:Label text="Part B -> Part C" class="dt-table__cell joint-name" />
                    <ui:Label text="Surface  #2" class="dt-table__cell joint-node" />
                    <ui:Label text="F:900N T:410Nm" class="dt-table__cell joint-magnitudes" />
                    <ui:VisualElement class="joint-gauges">
                        <ui:VisualElement class="joint-gauge"><ui:Label text="F" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" style="width: 70%;" /></ui:VisualElement><ui:Label text="70%" class="joint-gauge-value" /></ui:VisualElement>
                        <ui:VisualElement class="joint-gauge"><ui:Label text="T" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" style="width: 40%;" /></ui:VisualElement><ui:Label text="40%" class="joint-gauge-value" /></ui:VisualElement>
                        <ui:VisualElement class="joint-gauge"><ui:Label text="U" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" style="width: 70%;" /></ui:VisualElement><ui:Label text="70%" class="joint-gauge-value" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="joint-row dt-table__row">
                    <ui:Label text="L:Physical" class="dt-table__cell joint-kind" />
                    <ui:Label text="Part A -> Part C" class="dt-table__cell joint-name" />
                    <ui:Label text="Stack  #3  joints:4" class="dt-table__cell joint-node" />
                    <ui:Label text="F:0N T:0Nm" class="dt-table__cell joint-magnitudes" />
                    <ui:VisualElement class="joint-gauges">
                        <ui:VisualElement class="joint-gauge"><ui:Label text="F" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" /></ui:VisualElement><ui:Label text="0%" class="joint-gauge-value" /></ui:VisualElement>
                        <ui:VisualElement class="joint-gauge"><ui:Label text="T" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" /></ui:VisualElement><ui:Label text="0%" class="joint-gauge-value" /></ui:VisualElement>
                        <ui:VisualElement class="joint-gauge"><ui:Label text="U" class="joint-gauge-label" /><ui:VisualElement class="joint-gauge-bar"><ui:VisualElement class="joint-gauge-fill" /></ui:VisualElement><ui:Label text="0%" class="joint-gauge-value" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

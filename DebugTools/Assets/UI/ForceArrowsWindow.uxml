<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="DebugWindow.uss" />
    <Style src="ForceArrowsWindow.uss" />
    <ui:ScrollView name="root" horizontal-scroller-visibility="Hidden" class="dt-tool kui-dense force-arrows">
        <ui:Toggle name="draw" label="Draw force arrows" class="kui-field" />
        <ui:Toggle name="drag" label="Drag (red)" value="true" class="kui-field" />
        <ui:Toggle name="lift" label="Lift (cyan)" value="true" class="kui-field" />
        <ui:Toggle name="thrust" label="Thrust (green)" value="true" class="kui-field" />
        <ui:Slider name="scale" label="Length scale" low-value="-2" high-value="4" value="1" class="kui-field" />
        <ui:Label name="readout" class="kui-value force-wrap" />
        <ui:FloatField name="minimum" label="Minimum force (kN)" value="0.05" class="kui-field" />
        <ui:Label text="Per-part forces on the active vessel. Close to clear." class="kui-value force-wrap" />
        <ui:Button name="capture" text="Capture report" class="kui-button" />
    </ui:ScrollView>
</ui:UXML>

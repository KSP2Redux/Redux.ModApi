.tb-ksc {
    min-width: 136px;
    margin-right: var(--kui-gap);
}

.tb-autosave-label {
    -unity-text-align: middle-right;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tb-list-label {
    flex-grow: 0;
}

.tb-picker {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 4px 0 0;
}

.tb-step {
    min-width: 76px;
    margin: 0 0 0 2px;
}

.tb-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 4px 0 0;
}

.tb-manage-button {
    min-width: 72px;
    margin-left: 4px;
}

.tb-table {
    flex-grow: 0;
    flex-shrink: 0;
    margin: 4px 0;
    border-width: 1px;
    border-color: var(--kui-divider);
    background-color: var(--kui-fill-stat);
}

.tb-scroll {
    min-height: 40px;
    max-height: 160px;
    flex-grow: 0;
}

.tb-add-row {
    margin-bottom: 2px;
}

.teleport-bookmark-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px;
    color: var(--kui-text);
}

.teleport-bookmark-row:hover {
    background-color: var(--kui-hover);
}

.teleport-bookmark-row > Label {
    margin: 0;
    padding: 0 6px 0 0;
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.teleport-bookmark-row__name {
    flex-grow: 3;
    flex-basis: 0;
    min-width: 0;
}

.teleport-bookmark-row__body-name {
    flex-grow: 2;
    flex-basis: 0;
    min-width: 0;
}

.teleport-bookmark-row__type {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.teleport-bookmark-row__actions {
    flex-direction: row;
    flex-shrink: 0;
    width: 84px;
}

.teleport-bookmark-row .teleport-bookmark-row__teleport-button.unity-button.unity-text-element,
.teleport-bookmark-row .teleport-bookmark-row__delete-button.unity-button.unity-text-element {
    height: 16px;
    min-height: 16px;
    min-width: 38px;
    margin: 0 0 0 4px;
    padding: 0 4px;
    font-size: 11px;
}

.teleport-bookmark-row__selected,
.teleport-bookmark-row__selected:hover {
    background-color: rgba(115, 121, 221, 0.28);
}

.teleport-bookmark-row__header,
.teleport-bookmark-row__header:hover {
    color: var(--kui-text-strong);
    background-color: rgb(46, 53, 64);
}

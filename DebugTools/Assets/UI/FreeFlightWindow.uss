.ff-label {
    flex-grow: 0;
}

.ff-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 0 0 var(--kui-gap);
}

.ff-buttons {
    flex-direction: row;
    margin: 0 -2px 4px -2px;
}

.ff-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 2px;
}

.ff-button .oab-button__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ff-status {
    margin: 0;
    padding: 0;
    min-height: 18px;
    font-size: var(--kui-font-small);
    color: var(--kui-text);
    -unity-text-align: middle-left;
    white-space: normal;
}

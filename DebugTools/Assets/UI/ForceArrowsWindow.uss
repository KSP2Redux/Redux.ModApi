.force-arrows { width: 640px; min-width: 420px; max-width: 640px; flex-grow: 0; max-height: 620px; }
.force-arrows .force-wrap { white-space: normal; height: auto; flex-shrink: 0; -unity-text-align: upper-left; }
.force-arrows .unity-scroll-view__content-container { min-width: 0; flex-grow: 0; }
.force-arrows .unity-scroll-view { height: auto; }
.force-arrows.unity-scroll-view { height: auto; }

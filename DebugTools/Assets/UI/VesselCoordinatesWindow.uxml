<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=3b02df7e5905e8746a5ed673f30eb0be&amp;type=3#DebugWindow"/>
    <Style src="project://database/Assets/Modules/Redux.ModApi/DebugTools/Assets/UI/VesselCoordinatesWindow.uss?fileID=7433441132597879392&amp;guid=dacfacb2c23db1148ba02a8f469c3fd3&amp;type=3#VesselCoordinatesWindow"/>
    <ui:VisualElement name="root" class="dt-tool VesselCoordinatesWindow">
        <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="oab-window-body kui-panel">
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Coordinates" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:VisualElement class="dt-grid-2 state-grid">
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Latitude" class="kui-stat__name"/>
                    <ui:Label name="latitude" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Longitude" class="kui-stat__name"/>
                    <ui:Label name="longitude" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Heading" class="kui-stat__name"/>
                    <ui:Label name="heading" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Zenith" class="kui-stat__name"/>
                    <ui:Label name="zenith" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Pitch" class="kui-stat__name"/>
                    <ui:Label name="horizon-pitch" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Situation" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:VisualElement class="dt-grid-2 state-grid">
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Body" class="kui-stat__name"/>
                    <ui:Label name="celestial-body" text="Kerbin" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Origin" class="kui-stat__name"/>
                    <ui:Label name="origin-distance" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Situation" class="kui-stat__name"/>
                    <ui:Label name="situation" text="Flying" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Landed" class="kui-stat__name"/>
                    <ui:Label name="landed" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Splashed" class="kui-stat__name"/>
                    <ui:Label name="splashed" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Altitude" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:VisualElement class="dt-grid-2 state-grid">
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Radius" class="kui-stat__name"/>
                    <ui:Label name="alt-radius" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Terrain" class="kui-stat__name"/>
                    <ui:Label name="alt-terrain" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Sea Level" class="kui-stat__name"/>
                    <ui:Label name="alt-sl" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Scenery" class="kui-stat__name"/>
                    <ui:Label name="alt-scenery" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Surface" class="kui-stat__name"/>
                    <ui:Label name="alt-surface" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Orbit" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:VisualElement class="dt-grid-2 state-grid">
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Semi Major Axis" class="kui-stat__name"/>
                    <ui:Label name="semi-major-axis" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Eccentricity" class="kui-stat__name"/>
                    <ui:Label name="eccentricity" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Inclination" class="kui-stat__name"/>
                    <ui:Label name="inclination" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Long. Asc. Node" class="kui-stat__name"/>
                    <ui:Label name="long-asc-node" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Arg. Periapsis" class="kui-stat__name"/>
                    <ui:Label name="periapsis" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Epoch" class="kui-stat__name"/>
                    <ui:Label name="epoch" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Mean Anomaly at Epoch" class="kui-stat__name"/>
                    <ui:Label name="epoch-anomaly" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Hand of Kraken" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:Toggle name="toggle-hok" label="Hand of Kraken enabled" class="switch kui-row"/>
            <ui:VisualElement class="dt-grid-2 state-grid">
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Physics Mode" class="kui-stat__name"/>
                    <ui:Label name="hok-phys-mode" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Correcting Orbit" class="kui-stat__name"/>
                    <ui:Label name="hok-correcting" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Got Expected Orbit" class="kui-stat__name"/>
                    <ui:Label name="hok-got-pos" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Under Acceleration" class="kui-stat__name"/>
                    <ui:Label name="hok-under-accel" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Orbit Standoff" class="kui-stat__name"/>
                    <ui:Label name="hok-orbit-standoff" text="false" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="kui-section">
                <ui:Label text="//" class="kui-section__slashes"/>
                <ui:Label text="Control inputs" class="kui-section__title"/>
            </ui:VisualElement>
            <ui:VisualElement class="dt-grid-2 state-grid">
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Pitch input" class="kui-stat__name"/>
                    <ui:Label name="pitch" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Yaw input" class="kui-stat__name"/>
                    <ui:Label name="yaw" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Roll input" class="kui-stat__name"/>
                    <ui:Label name="roll" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="kui-stat">
                    <ui:Label text="Control state" class="kui-stat__name"/>
                    <ui:Label name="control-state" text="0.000000" class="kui-stat__value" display-tooltip-when-elided="true"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </UitkForKsp2.Controls.InvertedCornerBox>
    </ui:VisualElement>
</ui:UXML>
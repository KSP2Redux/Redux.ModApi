/* The grid wraps at 50% widths, which needs a definite width. An auto-sized pop-out would otherwise measure all stats
   as one row and grow to the screen width. */
.VesselCoordinatesWindow { width: 600px; max-width: 100%; }
.VesselCoordinatesWindow .state-grid > .kui-stat { width: 50%; min-width: 0; }
.VesselCoordinatesWindow #toggle-hok { padding: 0 16px; }
.VesselCoordinatesWindow .kui-stat__name { min-width: 0; flex-shrink: 1; font-size: 14px; }
.VesselCoordinatesWindow .kui-stat__value { min-width: 0; flex-shrink: 1; font-size: 14px; text-overflow: ellipsis; overflow: hidden; }
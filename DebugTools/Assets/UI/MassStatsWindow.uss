.MassStatsWindow .vessel-table { height: 260px; min-height: 100px; }
.MassStatsWindow .part-details { flex-direction: row; height: 20px; min-height: 20px; flex-shrink: 0; width: 900px; font-size: 12px; }
.MassStatsWindow .part-details > Label { font-size: 12px; flex-grow: 1; flex-basis: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-right; margin: 0; padding: 0 5px; }
.MassStatsWindow .part-details > .part-details__name { flex-grow: 2; -unity-text-align: middle-left; }
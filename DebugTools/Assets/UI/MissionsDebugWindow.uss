/* Missions: a pop-out tool. The frame, buttons and fields come from the KerbalUI theme and DebugWindow.uss. */

.dt-missions { width: 600px; max-width: 100%; }

.dt-missions-condition-scroll { min-height: 80px; max-height: 220px; flex-shrink: 1; }
.dt-missions-condition-detail { white-space: normal; font-size: 12px; margin: 2px 4px; }

/* Filter bar: dropdown, search and refresh on one 28px line */
.dt-missions-bar { margin-bottom: 2px; }
.dt-missions-filter { width: 170px; flex-shrink: 1; min-width: 110px; margin: 0 8px 0 0; }
.dt-missions-search { flex-grow: 1; flex-shrink: 1; min-width: 90px; margin: 0 8px 0 0; }
.dt-missions-refresh { flex-shrink: 0; min-width: 72px; }
.dt-missions-bar .unity-base-field__label { min-width: 0; width: auto; margin-right: 6px; font-size: 12px; }

/* The themed scroll view paints an inset panel at 100% size, so it is reset */
.unity-scroll-view.dt-missions-list {
    width: auto;
    height: auto;
    padding: 0;
    border-radius: 0;
    background-color: rgb(23, 26, 32);
}

/* Mission table */
.dt-missions-table { flex-shrink: 0; min-height: 0; }
/* The header keeps its full row height. Only the list under it shrinks, and it shows at least three rows. */
.dt-missions-table > .dt-table__header { flex-shrink: 0; }
.dt-missions-table > .unity-scroll-view { max-height: 144px; min-height: 64px; flex-shrink: 1; }

.mission-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.mission-row:hover { background-color: rgba(123, 124, 240, 0.06); }

.mission-row > .unity-label,
.mission-row > Label {
    margin: 0;
    padding: 0 4px 0 0;
    font-size: 12px;
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.mission-row__id { flex-grow: 3; }
.mission-row__name { flex-grow: 3; }
.mission-row__type { flex-grow: 2; }
.mission-row__owner { flex-grow: 2; }
.mission-row__state { flex-grow: 2; -unity-font-style: bold; }
.mission-row__stage-info { flex-grow: 1; }

/* The table header row. It leaves room for the scroll bar of the list under it. */
.dt-table__header.mission-row {
    background-color: rgb(46, 53, 64);
    color: rgb(154, 158, 167);
    padding-right: 13px;
}

.dt-table__header.mission-row > .unity-label { color: rgb(154, 158, 167); -unity-font-style: normal; }

.mission-row__selected,
.mission-row__selected:hover {
    background-color: rgb(42, 45, 60);
    border-left-color: rgb(123, 124, 240);
}

.mission-row__state--active .mission-row__state { color: rgb(90, 180, 120); }
.mission-row__state--complete .mission-row__state { color: rgb(120, 160, 220); }
.mission-row__state--failed .mission-row__state { color: rgb(194, 41, 25); }
.mission-row__state--inactive .mission-row__state { color: rgb(154, 158, 167); }

/* Selected mission */
.dt-missions-details { flex-shrink: 0; }
.dt-missions-stat { padding: 0 8px; }
.dt-missions-stat > .kui-stat__name { flex-grow: 0; flex-shrink: 0; width: 64px; }
.dt-missions-stat > .kui-stat__value { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.dt-missions-actions { flex-direction: row; margin: 4px 0 4px 0; }
.dt-missions-action { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; margin: 0 2px 0 0; }
.dt-missions-action--wide { flex-grow: 1.6; }

.dt-missions-dump-group { margin-top: 2px; }
.dt-missions-dump { margin: 0; padding: 0; }
.dt-missions-dump.unity-base-text-field,
.kui-dense .dt-missions-dump.unity-base-text-field {
    height: auto;
    min-height: 100px;
    max-height: 160px;
}
.dt-missions-dump.unity-base-text-field > .unity-base-field__input.unity-base-text-field__input,
.kui-dense .dt-missions-dump.unity-base-text-field > .unity-base-field__input.unity-base-text-field__input {
    height: auto;
    min-height: 100px;
    max-height: 160px;
    white-space: normal;
    font-size: 12px;
}

/* Stages: one 20px line each */
.dt-missions-stages { max-height: 120px; min-height: 24px; flex-shrink: 1; }

.stage-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    min-height: 20px;
    padding: 0 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.stage-row > .unity-label,
.stage-row > Label {
    margin: 0;
    padding: 0 4px 0 0;
    font-size: 12px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.stage-row__index { width: 28px; flex-shrink: 0; color: rgb(154, 158, 167); }
.stage-row__name { flex-grow: 2; flex-basis: 0; -unity-font-style: bold; }
.stage-row__objective { flex-grow: 3; flex-basis: 0; color: rgb(192, 199, 213); }
.stage-row__status { width: 86px; flex-shrink: 0; -unity-font-style: bold; }

.stage-row__btn.kui-button.unity-button.unity-text-element {
    height: 18px;
    min-height: 18px;
    min-width: 44px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    font-size: 11px;
}

.stage-row__current {
    background-color: rgba(90, 180, 120, 0.15);
    border-left-color: rgb(90, 180, 120);
}

.stage-row__completed > .stage-row__status { color: rgb(120, 160, 220); }
.stage-row__active > .stage-row__status { color: rgb(90, 180, 120); }
.stage-row__inactive > .stage-row__status { color: rgb(154, 158, 167); }

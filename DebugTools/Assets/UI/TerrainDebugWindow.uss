.dt-terrain-switches > .kui-row { width: 50%; padding-right: 6px; }
.dt-terrain-picker { flex-grow: 1; flex-basis: 0; min-width: 0; }

#select-quad { width: 120px; }
#update-triplanar-basis, #reset-triplanar-basis { width: 72px; margin-left: 4px; }

.dt-terrain-picker-row > .kui-row__label {
    width: 132px;
    flex-grow: 0;
    flex-shrink: 0;
}
